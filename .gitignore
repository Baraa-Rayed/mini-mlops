# Orchestrator state: the SQLite DB, run directories, gitops checkouts.
# Runtime state, never source — this is the whole reason MINI_HOME exists.
.mini-mlops/
mini-home/

# MLflow's store. Runs, metrics and model artifacts live beside the
# orchestrator's own state under MINI_HOME, but a stray `mlflow ui` in this
# directory creates ./mlruns -- committing binaries is how repos reach a gigabyte.
mlruns/
mlartifacts/
mlflow.db
model_registry/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
